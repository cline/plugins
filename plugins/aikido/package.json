{
  "name": "aikido",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cline plugin that registers Aikido Security MCP tools and bundles Aikido workflow skills.",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "mcp",
          "skills"
        ]
      }
    ]
  },
  "dependencies": {
    "@aikidosec/mcp": "1.0.9"
  }
}
