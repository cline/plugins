{
  "name": "chrome-devtools-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cline plugin that installs Chrome DevTools MCP and bundles browser debugging skills.",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "mcp",
          "skills"
        ]
      }
    ]
  },
  "dependencies": {
    "chrome-devtools-mcp": "1.2.0"
  }
}
