{
  "name": "imessage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cline plugin that adds macOS iMessage MCP tools and setup skills.",
  "scripts": {
    "start": "bun server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10"
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "mcp",
          "skills"
        ]
      }
    ]
  }
}
