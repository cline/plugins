{
  "name": "zoominfo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cline plugin for ZoomInfo B2B sales intelligence, prospecting, enrichment, and account research workflows.",
  "exports": {
    ".": "./index.ts"
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "mcp",
          "skills"
        ]
      }
    ]
  },
  "peerDependencies": {
    "@cline/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    }
  }
}
