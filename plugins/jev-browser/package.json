{
  "name": "jev-browser",
  "version": "0.2.2",
  "description": "Isolated Playwright jev-browser tools for Cline agents.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "tools",
          "rules"
        ]
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.85",
    "ai": "7.0.105",
    "playwright": "^1.58.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
